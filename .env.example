# 仅在数据库为空时用于创建超级管理员，创建后这两项会被忽略。
# 不设置时的默认值是 admin / admin123（弱默认，仅用于首次启动，登录后请立即修改密码）
SUPER_ADMIN_USER=admin
SUPER_ADMIN_PASSWORD=change-this-password

PORT=3000
SESSION_TTL_HOURS=168

# 容器时区（定时备份按此时钟执行）
TZ=Asia/Shanghai

# 部署在 HTTPS 后面时改为 true
COOKIE_SECURE=false

# 以下为运行级设置的初始默认值（仅数据库无记录时生效；在管理界面保存后以数据库为准）
REQUESTLOG_CAPACITY=2000
SELFCHECK_TIMEOUT_SECONDS=8
BACKUP_ENABLED=false
BACKUP_TIME=23:00
BACKUP_KEEP=7
